# ============================================
# API Configuration
# ============================================
# OpenAI API Key - Obtenir sur https://platform.openai.com/api-keys
API_KEY=your_openai_api_key_here

# ============================================
# Database Configuration
# ============================================
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=princept_rag_db

# ============================================
# Application Configuration
# ============================================
# Environment: development, staging, production
APP_ENV=development

# Upload Configuration
UPLOAD_DIR=App/Data/Uploads
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=3
ALLOWED_EXTENSIONS=.pdf,.docx

# Document Processing
MAX_PAGES_PER_DOCUMENT=150
CHUNK_SIZE=750
CHUNK_OVERLAP=75

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100

# LLM Configuration
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Chat Configuration
MAX_MESSAGES_PER_CHAT=30

# ============================================
# Optional: Advanced Features
# ============================================
# Llama Cloud (pour parsing avancé de documents)
# LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key

# LangSmith (pour monitoring et debugging)
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=princept-rag

# ============================================
# Security (Production Only)
# ============================================
# SECRET_KEY=your-secret-key-for-jwt
# CORS_ORIGINS=https://yourdomain.com